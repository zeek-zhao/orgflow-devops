# Dex 配置模板 —— 由 scripts/render-dex.sh 渲染成 out/dex/config.yaml
#
# 为什么用模板而不是环境变量：issuer 与 redirectURIs 必须是浏览器实际访问的
# 绝对 URL，而 dex 是 scratch 镜像（没有 shell，做不了启动期渲染）。
# 在部署侧渲染，域名一变重新生成即可，行为可预测、可测试。
#
# 占位符：
#   __DEX_ISSUER__           https://dex.<domain>/dex
#   __OAUTH2_REDIRECT_URI__  https://auth.<domain>/oauth2/callback
#   __DOCS_OAUTH2_REDIRECT_URI__  https://docs.<domain>/oauth2/callback (#86:docs 单域闭环)

issuer: __DEX_ISSUER__
storage:
  type: memory
web:
  http: 0.0.0.0:5556
staticClients:
  - id: jenkins
    secretEnv: OAUTH2_CLIENT_SECRET
    redirectURIs:
      - __OAUTH2_REDIRECT_URI__
      - __DOCS_OAUTH2_REDIRECT_URI__
    name: OrgFlow
connectors:
  - type: ldap
    id: ldap
    name: OpenLDAP
    config:
      host: ldap:389
      insecureNoSSL: true
      bindDN: cn=admin,dc=devops,dc=com
      bindPW: ${LDAP_ADMIN_PASSWORD}
      userSearch:
        baseDN: ou=users,dc=devops,dc=com
        filter: "(objectClass=inetOrgPerson)"
        username: uid
        idAttr: uid
        emailAttr: mail
        nameAttr: cn
      groupSearch:
        baseDN: ou=groups,dc=devops,dc=com
        filter: "(objectClass=posixGroup)"
        userMatchers:
          - userAttr: uid
            groupAttr: memberUid
        nameAttr: cn
oauth2:
  skipApprovalScreen: true
