# Gerrit 配置模板（文档 §M2.1）：所有公网 URL / 端口用占位符，
# 由 services/gerrit/entrypoint.sh 启动时从 out/urls.env + defaults.env 渲染到
# /var/gerrit/etc/gerrit.config（先备份 .bak），杜绝字面域名/端口入库。
[gerrit]
    canonicalWebUrl = ${GERRIT_PUBLIC_URL}
    basePath = git

[auth]
    type = LDAP
    httpPasswordUrl = ${GERRIT_PUBLIC_URL}settings/#HTTPCredentials

[ldap]
    server = ldap://ldap:389
    # LDAP ACL 匿名拒读（M0 安全基线），Gerrit 搜索用户 DN 须用服务账号 bind。
    # 正确键是 username/password（非 bindDN/bindCredential）；supportAnonymous=false
    # 强制关闭 Gerrit 的默认匿名探测。口令走占位符，entrypoint 用 LDAP_ADMIN_PASSWORD
    # 运行时渲染到卷内 gerrit.config（600/gerrit），不进 git 源码/文档。
    supportAnonymous = false
    username = cn=admin,dc=orgflow,dc=local
    password = ${LDAP_BIND_CREDENTIAL}
    accountBase = ou=people,dc=orgflow,dc=local
    accountPattern = (&(objectClass=person)(uid=${username}))
    groupBase = ou=groups,dc=orgflow,dc=local
    groupPattern = (&(objectClass=groupOfNames)(cn=${groupname}))

[httpd]
    listenUrl = proxy-http://*:${P_GERRIT_HTTP}

[sshd]
    listenAddress = *:${P_GERRIT_SSH}

[database]
    type = h2
    database = /var/gerrit/db/ReviewDB

[index]
    type = LUCENE

[receive]
    enableSignedPush = false

[sendemail]
    smtpServer = localhost

[container]
    user = gerrit2
