[Unit]
Description=OrgFlow 每日 03:30 定时备份（M3.0.1，真机 systemd 模板；沙箱 PID1=supervisord 用 backup-daemon.sh 常驻）
Documentation=file:__REPO__/docs/运维/备份与恢复.md

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
Unit=orgflow-backup.service

[Install]
WantedBy=timers.target

; 说明：backup-daemon.sh 自带常驻 03:30 调度，systemd 场景二选一：
;   A) 用 service（Type=simple 常驻），不启用本 timer；
;   B) 用本 timer + 把 service 的 ExecStart 改为 backup-daemon.sh once（瞬时一轮）。
; 沙箱 PID1=supervisord，两者均不启用，由 deploy/supervisor/orgflow-backup.conf 管理。
