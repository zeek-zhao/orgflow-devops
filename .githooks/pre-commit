#!/usr/bin/env bash
# =============================================================================
# pre-commit —— 提交身份 + 快检查
#
#   规则 1：author 与 committer 必须是 zeek.zhao <zeek.zhao@foxmail.com>
#   规则 2：scripts/check-fast.sh（文档配置 / 死链 / 脱敏 / 标签清单，几秒）
#   装法：make hooks        （设置 core.hooksPath=.githooks）
#   绕过：GIT_IDENTITY_ALLOW=1（仅自动化 / 历史迁移）、CHECK_FAST_ALLOW=1（仅紧急）
#
#   为什么要有身份检查：开发机（尤其 214）的 git 全局身份是
#   Jenkins-SWD <jenkins-swd@example.com>，copilot 在那台机器上
#   提交就会带错身份。错误身份一旦进历史只能重写补救，代价远高于一次拦截。
# =============================================================================
set -uo pipefail

want_name="zeek.zhao"
want_email="zeek.zhao@foxmail.com"

# 自动化场景（CI 机器人、历史迁移）可显式放行
[[ "${GIT_IDENTITY_ALLOW:-0}" == 1 ]] && exit 0

check() {
  local kind="$1" ident="$2" name email
  name="${ident%% <*}"
  email=$(printf '%s' "$ident" | sed -n 's/^[^<]*<\([^>]*\)>.*$/\1/p')

  [[ "$name" == "$want_name" && "$email" == "$want_email" ]] && return 0

  printf '\n[pre-commit] ✗ %s 身份不符\n' "$kind" >&2
  printf '  期望：%s <%s>\n' "$want_name" "$want_email" >&2
  printf '  实际：%s <%s>\n\n' "$name" "$email" >&2
  printf '  修复：\n' >&2
  printf '    git config user.name  "%s"\n' "$want_name" >&2
  printf '    git config user.email "%s"\n\n' "$want_email" >&2
  return 1
}

rc=0
check author    "$(git var GIT_AUTHOR_IDENT)"    || rc=1
check committer "$(git var GIT_COMMITTER_IDENT)" || rc=1

# ---- 快检查 -----------------------------------------------------------------
# 只放「不需要 docker、不需要网络、几秒内」的：文档配置 / 死链 / 脱敏 / 标签清单。
# 重的（make test、bats、lint）在 pre-push，理由写在 scripts/check-all.sh 抬头。
# 定义只有一处（scripts/check-fast.sh），钩子与 make check 共用，避免钩子与 CI 漂移。
#   绕过：CHECK_FAST_ALLOW=1 git commit …
if [[ "$rc" -eq 0 && "${CHECK_FAST_ALLOW:-0}" != 1 ]]; then
  if ! bash "$(git rev-parse --show-toplevel)/scripts/check-fast.sh"; then
    printf '\n[pre-commit] 快检查未通过。绕过（不推荐）：CHECK_FAST_ALLOW=1 git commit …\n\n' >&2
    rc=1
  fi
fi

exit "$rc"
