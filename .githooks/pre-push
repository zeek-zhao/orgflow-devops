#!/usr/bin/env bash
# =============================================================================
# pre-push —— 主干保护 + 提交身份校验
#
#   装法：make hooks          （设置 core.hooksPath=.githooks）
#   绕过主干保护：WF4_ALLOW_PUSH_MAIN=1 git push   （仅紧急情况，别常态化）
#   绕过身份校验：GIT_IDENTITY_ALLOW=1 git push    （仅历史迁移）
#
#   为什么要它：私有库 + GitHub 免费计划下，branch protection / rulesets
#   接口一律 403 Upgrade to GitHub Pro，本地钩子是唯一防线（公开后 ruleset 是第二道，
#   见 #129；本地钩子仍保留，因为 ruleset 拦不住误推错的仓库配置）。
#
#   身份规则（与 CONTRIBUTING.md 一致）：
#     - author    必须恒为 zeek.zhao <zeek.zhao@foxmail.com>
#     - committer 在非主干分支上必须同上；主干允许 GitHub squash 机器人
#     - 检查范围：本次推送真正新增的提交（新分支 = 主干..HEAD，不扫全量历史），
#       且跳过合并提交（平台产物）
# =============================================================================
set -uo pipefail

want_email="zeek.zhao@foxmail.com"
protected="main master"
zero="0000000000000000000000000000000000000000"
rc=0

is_protected() {
  [[ " $protected " == *" $1 "* ]]
}

while read -r _local_ref local_sha remote_ref remote_sha; do
  [[ "$remote_ref" == refs/heads/* ]] || continue
  br="${remote_ref#refs/heads/}"

  # ---- ① 主干保护 -----------------------------------------------------------
  if is_protected "$br" && [[ "${WF4_ALLOW_PUSH_MAIN:-0}" != 1 ]]; then
    printf '\n[pre-push] ✗ 禁止直接推 %s\n' "$br" >&2
    printf '  正确做法：git switch -c feat/<issue#>-<slug> → 提交 → 开 PR\n' >&2
    printf '  紧急绕过：WF4_ALLOW_PUSH_MAIN=1 git push（请勿常态化）\n\n' >&2
    rc=1
    continue
  fi

  # ---- ② 身份校验 -----------------------------------------------------------
  [[ "${GIT_IDENTITY_ALLOW:-0}" == 1 ]] && continue
  [[ "$local_sha" == "$zero" ]] && continue            # 删除分支，无提交可查
  if [[ "$remote_sha" == "$zero" ]]; then
    # 新分支：只查「相对主干新增」的提交，不能扫全量历史。
    # 主干上的 rebase/squash 合并提交 committer 是 GitHub 机器人，
    # 全量扫会让任何新分支都推不上去。
    base=""
    for cand in origin/main main origin/master master; do
      if git rev-parse --verify -q "$cand" >/dev/null 2>&1; then base="$cand"; break; fi
    done
    if [[ -n "$base" ]]; then
      range="$base..$local_sha"
    else
      range="$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi

  # --no-merges：合并提交是平台产物（GitHub 为 PR 生成的 refs/pull/n/merge），
  # 与 CI 的 identity.yml 保持一致。
  while read -r sha ae ce; do
    [[ -z "$sha" ]] && continue

    if [[ "$ae" != "$want_email" ]]; then
      printf '\n[pre-push] ✗ %s 的 author 邮箱是 %s\n' "${sha:0:8}" "$ae" >&2
      printf '  期望：%s\n' "$want_email" >&2
      rc=1
    fi

    if ! is_protected "$br" && [[ "$ce" != "$want_email" ]]; then
      printf '\n[pre-push] ✗ %s 的 committer 邮箱是 %s\n' "${sha:0:8}" "$ce" >&2
      printf '  期望：%s（主干分支允许 GitHub squash 机器人）\n' "$want_email" >&2
      rc=1
    fi
  done < <(git log --no-merges --format='%H %ae %ce' "$range" 2>/dev/null)
done

# ---- ③ 重检查 ---------------------------------------------------------------
# 身份与主干都过了才跑：检查本身要几分钟，先挡能秒判的问题。
#   跳过 bats：SKIP_BATS=1 git push   （会打印「CI 会跑」，不静默）
#   整体跳过：  CHECK_ALL_ALLOW=1 git push（仅紧急）
if [[ "$rc" -eq 0 && "${CHECK_ALL_ALLOW:-0}" != 1 ]]; then
  if ! bash "$(git rev-parse --show-toplevel)/scripts/check-all.sh"; then
    printf '\n[pre-push] 重检查未通过。绕过（不推荐）：CHECK_ALL_ALLOW=1 git push\n\n' >&2
    rc=1
  fi
fi

exit "$rc"
