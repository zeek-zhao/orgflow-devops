# 独立命名空间测试环境（M0-v2 §8.0）—— 与线上完全隔离，零停机纪律
# 用法：ENV_FILE=tests/v2.env CONTAINER_PREFIX=ofv2 DRY_RUN=1 bash up.sh
#   或：bash tests/run-v2.sh up   （runner 自动注入以下变量）
# 关键：网络/卷/容器名/IP/宿主端口全部与线上 of-*（192.168.90.x）错开，
#       测试栈的 stop/down 不会影响线上任何容器/网络/卷。

# 域名保持与线上同构（DNS/证书/路由断言依赖固定域名），仅内网隔离
DOMAIN=org-devops.local
PUBLIC_HOST=orgflow-v2.test

# 独立子网与 IP（192.168.91.0/24，与线上 192.168.90.0/24 不同段）
NET_SUBNET=192.168.91.0/24
IP_DNSMASQ=192.168.91.15
IP_CADDY=192.168.91.10
IP_LDAP=192.168.91.13
IP_LDAPADMIN=192.168.91.12
IP_HOMEPAGE=192.168.91.11
IP_ROUTER=192.168.91.14

# 独立宿主端口（+1000 偏移，避免占用线上 5353/808x/18081）
P_CADDY_HTTP=9080
P_CADDY_HTTPS=9443
P_DNSMASQ=15353
P_LDAP=13389
P_LDAPADMIN=9081
P_HOMEPAGE=9082
P_ROUTER=9083
PUBLIC_PORT=28081

# 独立网络/卷（external 名带 v2 后缀，与线上 orgflow-minimal_* 卷隔离）
ORG_NETWORK=orgflow-v2-net
CA_DATA_VOLUME=orgflow-v2-ca-data
LDAP_DATA_VOLUME=orgflow-v2-ldap-data
LDAP_CONFIG_VOLUME=orgflow-v2-ldap-config

# 容器名前缀（up.sh 与 compose 共用；默认 of，测试设 ofv2）
CONTAINER_PREFIX=ofv2
