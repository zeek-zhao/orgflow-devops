# 镜像真源（修复轮 T2：本地构建能力，可选模式）—— T10 起仅 USE_LOCAL_IMAGES=1 时生效。
#
# 【默认（USE_LOCAL_IMAGES=0，线上）】本文件不注入：compose 的 image 用
#   ${IMAGE_*:-<GHCR digest>}，回退到已验证的 GHCR 代理镜像（pull_policy:never 只用本地
#   已有镜像）→ 零停机，不依赖本地是否构建过。
# 【本地自建（USE_LOCAL_IMAGES=1）】up.sh 才把本文件作为最后一个 --env-file 注入，
#   使用下列 orgflow/m0-* 名；前置校验 check-images.sh lock + 目标镜像存在，
#   若 PENDING-BUILD 或镜像缺失则告警并回退默认 GHCR（绝不静默起不来）。
#   需先 `bash scripts/build-images.sh` 构建（certs-init 复用 router）。
# 上游 digest 固定在各 Dockerfile 的 FROM（下方 UPSTREAM_* 供 build/overlay 门禁读取）。
GHCR_PROXY=ghcr.nju.edu.cn
IMAGE_DNSMASQ=orgflow/m0-dnsmasq:v2
IMAGE_CERTS_INIT=orgflow/m0-router:v2
IMAGE_CADDY=orgflow/m0-caddy:v2
IMAGE_LDAP=orgflow/m0-ldap:v2
IMAGE_LDAPADMIN=orgflow/m0-ldapadmin:v2
IMAGE_HOMEPAGE=orgflow/m0-homepage:v2
IMAGE_ROUTER=orgflow/m0-router:v2
# M1：本地自建兜底 tag（仅 USE_LOCAL_IMAGES=1 使用；线上默认走 compose 里的 GHCR ctx tag）
# r5 §2：ctx-<12> = scripts/image-hash.sh <svc> 前 12 位，与 tests/images.lock 一致。
IMAGE_JENKINS=orgflow/m1-jenkins:ctx-73634ada3b5b
IMAGE_JENKINS_AGENT=orgflow/m1-jenkins-agent:ctx-951abc7a53fd
# M2.1：cgit 官方源自建（内容哈希 ctx tag）；M2.2 P1-3 命名统一为 m2 前缀。
# cgit tag 后缀 = scripts/image-hash.sh cgit 前 12 位，与 tests/images.lock 一致。
IMAGE_CGIT=orgflow/m2-cgit:ctx-e0643a8c475e
# M2.1：Gerrit 官方镜像已由 CI 中转落地 GHCR（compose 回退同址）。M2.2 P2-1 去掉过期 TODO。
IMAGE_GERRIT=ghcr.io/zeek-zhao/orgflow-devops/m2-gerrit:3.9.0
# M2.2：registry:2 薄封装（FROM registry:2 + apache2-utils），tag 后缀 = image-hash.sh registry 前 12 位。
# M2.2 P1-3 命名统一为 m2 前缀（与 GHCR 路径 m2-registry 对齐）。
IMAGE_REGISTRY=orgflow/m2-registry:ctx-1cb303e1dbfa
# M2.3：builder（rootless buildkitd）——tag 后缀 = image-hash.sh builder 前 12 位。
IMAGE_BUILDER=orgflow/m2-builder:ctx-9e393f1c9787

# ---- 上游官方镜像 digest 登记（build-images.sh / check-images --mode=overlay 读取）----
# 与 Dockerfile FROM @sha256 逐项一致；不是运行时引用，仅锁定供应链来源。
UPSTREAM_HOMEPAGE=sha256:19c5c09184458a41b7b5915e71463a39f36cd33540f41bdbed008791b8182d5f
UPSTREAM_CADDY=sha256:36c24ad91a7ff7bc4c87fe22bfa8df3c4b18da0773d73fc12ee2c52b98c0bb7e
UPSTREAM_LDAP=sha256:18742e9c449c9c1afe129d3f2f3ee15fb34cc43e5f940a20f3399728f41d7c28
UPSTREAM_LDAPADMIN=sha256:d112b82be1336f91e028b0348755133fda333992355b533419355a65c32ff9ad
UPSTREAM_DNSMASQ=sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
UPSTREAM_ROUTER=sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
UPSTREAM_CERTS_INIT=sha256:e5fd71d1cd7cec5068a24ce1165e35587856e2cafe7ca2e772a3b50944f9fe87
# M1 上游 digest（与两个 Dockerfile FROM 一致）
UPSTREAM_JENKINS=sha256:74401de6a6f92e1afe1b02d1c8e3d0c33f263bfb5275dd8813f9150355f2367b
UPSTREAM_JENKINS_AGENT=sha256:8fbbc589fa4257287cb9903ed1e021b90db2be2827a80e86a433d9395ca7d019
# M2.1 上游：cgit = ubuntu:24.04 基底；gerrit = 官方镜像 manifest digest（待拉取后回填真实值）
UPSTREAM_CGIT=sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
UPSTREAM_GERRIT=sha256:25f02a983db5f2323fa2a4be7ea672a13dbe8a12cc0e0d31feaa5a348ad8df0f
# M2.2：registry:2 上游 manifest digest（CI run 45755446885 docker pull 产出真实值）
UPSTREAM_REGISTRY=sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
# M2.3：buildkit v0.16.0-rootless 上游 amd64 manifest digest（2026-11-26 查 Docker Hub）
UPSTREAM_BUILDER=sha256:ae19c93689d1a9f510c656c83a68f41a9d97a87dddbc285af078fc7522074111
