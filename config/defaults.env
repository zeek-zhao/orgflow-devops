# 最小系统唯一人工配置源（非敏感默认值；敏感口令走 .env，不入库）
# 改完执行: make render  然后 make up
DOMAIN=org-devops.local
# 公网入口域名（Tailscale Funnel 边缘证书对应的主机名，注入 homepage 白名单）。
# 换公网域名只改这里；留空则公网访问 homepage 会被 403。
PUBLIC_HOST=orgflow-sandbox.tail0b7621.ts.net
# 容器固定 IP 段（192.168.90.0/24）
NET_SUBNET=192.168.90.0/24
IP_DNSMASQ=192.168.90.15
IP_CADDY=192.168.90.10
IP_LDAP=192.168.90.13
IP_LDAPADMIN=192.168.90.12
IP_HOMEPAGE=192.168.90.11
IP_ROUTER=192.168.90.14
# M1：Jenkins controller / SSH agent 固定 IP
IP_JENKINS=192.168.90.16
IP_JENKINS_AGENT=192.168.90.17
# M2.1：Gerrit（代码评审/Git）/ cgit（只读 Web）固定 IP（§2 拓扑 .18/.19）
IP_GERRIT=192.168.90.18
IP_CGIT=192.168.90.19
# M2.2：registry:2 轻量镜像仓库固定 IP（§2 拓扑 .20）
IP_REGISTRY=192.168.90.20
# M2.3：BuildKit builder 固定 IP（.21）与容器内 gRPC 端口（不发布宿主）
IP_BUILDER=192.168.90.21
P_BUILDKIT=1234
# Jenkins 对外访问地址（反代下回调链接用）。
# T9.6：compose 已改由 PUBLIC_HOST 派生 JENKINS_URL，此处保留仅作脚本/本地回退；
# 改域名只需改上面的 PUBLIC_HOST（test-static 有 host 一致性断言）。
JENKINS_URL=https://orgflow-sandbox.tail0b7621.ts.net/jenkins/
# 隔离端口（单服务启动时用，避免占用 80/443）
P_CADDY_HTTP=8080
P_CADDY_HTTPS=8443
P_DNSMASQ=5353
P_LDAP=3389
P_LDAPADMIN=8081
P_HOMEPAGE=8082
P_ROUTER=8083
# 公网入口端口：Caddy 纯 HTTP 监听，Tailscale Funnel 边缘终止 TLS 后转发到此端口
PUBLIC_PORT=18081
# ---- M0-v2 R2：external 网络/卷真实名（§2.5 第0步盘点所得，带 orgflow-minimal_ 前缀）----
# 各服务 compose 用 external:true + name 引用，up.sh 幂等创建（存在即跳过，禁 --force）
ORG_NETWORK=orgflow-minimal_orgflow
CA_DATA_VOLUME=orgflow-minimal_ca-data
LDAP_DATA_VOLUME=orgflow-minimal_ldap_data
LDAP_CONFIG_VOLUME=orgflow-minimal_ldap_config
# M1：Jenkins controller 数据卷（Job 定义与构建历史，回滚不丢）
JENKINS_HOME_VOLUME=orgflow-minimal_jenkins_home
# M2.1：Gerrit 裸库卷（cgit 只读共享）与配置卷
GERRIT_GIT_VOLUME=orgflow-minimal_gerrit_git
GERRIT_ETC_VOLUME=orgflow-minimal_gerrit_etc
# M2.2：registry 镜像数据卷与 htpasswd 鉴权卷
REGISTRY_DATA_VOLUME=orgflow-minimal_registry_data
REGISTRY_AUTH_VOLUME=orgflow-minimal_registry_auth
# M2.3：BuildKit 构建缓存卷
BUILDER_CACHE_VOLUME=orgflow-minimal_builder_cache
# M2.4：自检报告共享卷（Jenkins rw /reports/selfcheck、Caddy ro /srv/reports）
SELFCHECK_REPORTS_VOLUME=orgflow-minimal_selfcheck_reports

# ---- M2 §1 三层端口模型（对外端口全部可配，禁止在 compose/Caddyfile/应用配置写死字面端口）----
# ① Funnel 边缘端口（公网可见）：只允许 443 / 8443 / 10000 三值之一；三个端口全部占满。
FUNNEL_PORT_ENTRY=443
FUNNEL_PORT_GERRIT=8443
FUNNEL_PORT_HARBOR=10000
# ② 宿主回环端口（Funnel 的回源目标 / Caddy 监听）：任意空闲口，需两两不同。
# PUBLIC_PORT（18081）见上方；下面两个为 Gerrit/Harbor 专用回源口。
PUB_HTTP_GERRIT=18085
PUB_HTTP_HARBOR=18086
# ③ 容器内监听口（服务自身端口，仅供反代与调试，一般不动）。
P_GERRIT_HTTP=8080
P_GERRIT_SSH=29418
P_CGIT_HTTP=80
P_HARBOR_PORTAL=8080
# M2.2：registry:2 容器内监听口（官方默认 5000）
P_REGISTRY_HTTP=5000
# M2.3：Gerrit serverId，必须跨重启稳定（NoteDb change meta 固化创建时的 server id，
# 漂移会导致 review/Verified 回写报 InvalidServerIdException）。值取自存量 Change 创建时的 id。
GERRIT_SERVER_ID=5593956a-8275-4e5c-82ee-8fb6b2c067dd