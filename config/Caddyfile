# Caddy 唯一入口的静态配置（对齐 main：官方 caddy:2 镜像直接执行，无自建 entrypoint）。
#
# 内网部分：按 Host 分站点，TLS 用共享 ca-data 卷里的站点证书（certs-init 签发）。
# 公网部分：Tailscale Funnel 在边缘终止 TLS 后转发到 :PUBLIC_PORT 纯 HTTP，
#           Caddy 按 path 反代到各服务。HomePage 占根路径 /（唯一门面），
#           /_next/ /api/ /site.webmanifest 等静态资源随根路径一起命中 homepage，杜绝裂图。
# 域名/端口用 Caddyfile 环境变量占位，由 compose environment 注入（改域名不用改本文件）。
#
# 拍定决策（orgflow-AI-提示词-最终版）：
#   - 单域名 + 路径前缀，不用子域名对外；HomePage 占 /。
#   - Admin 只绑内网 IP（容器网可达、公网不可达），删除公网 /caddy/*，
#     任何人不得从公网 POST /load 换掉反代（P0）。

{
    # 管理口收敛（M1 收口 T3）：容器内监听 0.0.0.0:2019（本机 127.0.0.1 与网桥
    # router 经 caddy:2019 均可达）；宿主端口映射限定 127.0.0.1:2019:2019，
    # 外部网络连不上宿主 2019。Funnel 只转发 :PUBLIC_PORT，公网亦无法触达。
    admin 0.0.0.0:2019
}

# 内网 :80 跳转骨架：公网入口走 :PUBLIC_PORT（Funnel 边缘终止 TLS），
# 内网如有人访问 :80 则跳 https（单域名路径型，不再维护子域 vhost / tls 站点）。
:80 {
    redir https://{host}{uri} permanent
}

# ===== 公网入口（Funnel → 本端口）=====
# T6 路由单一真源：本文件 = admin 全局 + :80 跳转 + :PUBLIC_PORT 路径骨架；
# 动态路由前缀在 config/routes.yaml；二者由 router /render 合成，输出即实跑配置。
# 不在此文件维护 home./ldapadmin./router. 子域站点（已删，无第二份配置）。
# TLS 在 Funnel 边缘终止并做合法 *.ts.net 证书，这里只做纯 HTTP 路由。
:{$PUBLIC_PORT:18081} {
    # 精确匹配优先，必须排在 / 之前
    @healthz path /healthz
    handle @healthz {
        respond "ok" 200
    }

    # /healthz 保持纯文本 ok（探活用，不要改成 HTML）
    # r5 §4-8：状态页唯一真源在 router GET /status（services/router/server.py）；
    # 此处仅反代，不再内联 HTML（原两份 HTML 会漂移，M1 加 Jenkins 时改两遍）。
    @status path /status
    handle @status {
        reverse_proxy router:8080
    }

    # T4 路径边界与跳转（308，精确匹配，必须在 handle_path / 兜底之前）
    @rootHome path /home /home/*
    handle @rootHome {
        redir https://{host}/ 308
    }
    @noSlashLdap path /ldapadmin
    handle @noSlashLdap {
        redir https://{host}/ldapadmin/ 308
    }
    @routerBare path /router
    handle @routerBare {
        redir https://{host}/router/healthz 308
    }
    # T9(P0)：/router/ 命中 handle_path /router/* 被 strip 成 /，router(BaseHTTP) 无 / 路由→404。
    # 在此处先于 handle_path 拦截，308 到 /router/healthz（不改 router 应用代码）。
    @routerRoot path /router/
    handle @routerRoot {
        redir https://{host}/router/healthz 308
    }
    @caddyLegacy path /caddy /caddy/*
    handle @caddyLegacy {
        redir https://{host}/status 308
    }
    # M1：/jenkins 无斜杠 → 308 到 /jenkins/（与 router PUBLIC_FIXED 同步）
    @jenkinsBare path /jenkins
    handle @jenkinsBare {
        redir https://{host}/jenkins/ 308
    }

    # T1 安全收口：公网禁止触发渲染（必须在 /router/* 之前，先命中先执行）。
    # 容器内本机 POST /render 经 docker exec 直连 127.0.0.1:8080，不走公网。
    @render path /router/render
    handle @render {
        respond 403
    }

    # R1(P1) 公网信息泄漏收口：/api/services 泄漏内网 IP/端口，/api/widgets 泄漏宿主资源。
    # 实测（外部公网 + 容器内双路，2026-11-24）：
    #   - remote_ip 方案失效：公网经 Funnel、容器内经 docker 网桥，.remote.host 同为 192.168.90.1，
    #     无论白名单写 127.0.0.1 还是内网网段都无法区分公网/内网（文档原方案 + 网段方案均已证伪）。
    #   - host 头方案可行：Funnel 保留原始 Host，公网 host=PUBLIC_HOST，内网可用 {$DOMAIN} 或容器 IP。
    # 故改用「仅允许内网 Host 头」兜底（文档 R1 做法1 认可的第二兜底）：
    #   放行 {$DOMAIN} 与 192.168.90.x，其余（含公网域名）403。域名走 {$DOMAIN} 占位符不写死。
    # 服务间调用走容器名直连（homepage:3000），不经本公网入口，不受影响；首页 12 卡为 SSR。
    # 残留风险（已知）：curl 可伪造 Host 头绕过；浏览器访公网域名无法伪造，属文档认可兜底的固有边界。
    @homeApi path /api/services /api/widgets
    handle @homeApi {
        @fromLan host {$DOMAIN} ^192[.]168[.]90[.][0-9]+$
        handle @fromLan {
            reverse_proxy homepage:3000
        }
        respond 403
    }

    handle_path /ldapadmin/* {
        reverse_proxy ldapadmin:80
    }

    handle_path /router/* {
        reverse_proxy router:8080
    }

    # M1：Jenkins 自带 --prefix=/jenkins，用 handle 保留完整路径（不能 handle_path 剥前缀）
    # T6：Funnel→Caddy 是 http，显式回写 https，避免 Jenkins 生成 http:// 外链（CSP report-uri）。
    handle /jenkins/* {
        reverse_proxy jenkins:8080 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
        }
    }

    # HomePage 占根路径，直接反代不 strip：
    # /_next/static/*、/api/config/*、/site.webmanifest、/favicon.ico 全部命中，杜绝裂图。
    # 必须是最后一个 handle（兜底），且用 handle 而非 handle_path 保留原始 URI。
    handle {
        reverse_proxy homepage:3000
    }
}
