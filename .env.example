# orgflow-devops 环境变量（复制为 .env 后填写，.env 不入库）

# --- 网关 ---
GATEWAY_PORT=8080
GATEWAY_DOMAIN=devops.internal

# --- Jenkins ---
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
JENKINS_URL=http://localhost:8080/jenkins
GITHUB_USER=zeek-zhao
# 必填：可读取此 private 仓库的 GitHub PAT，仅在本地 .env 填写
GITHUB_TOKEN=

# --- 权限管理服务（LDAP + Admin + Dex + OAuth2 Proxy）---
LDAP_ORGANISATION=OrgFlow
LDAP_DOMAIN=devops.com
LDAP_ADMIN_PASSWORD=change-me
LDAPADMIN_PORT=8081
OAUTH2_CLIENT_ID=jenkins
OAUTH2_CLIENT_SECRET=change-me
# 仅占位；部署前替换成随机的 32 字符密钥
OAUTH2_COOKIE_SECRET=0123456789abcdef0123456789abcdef

# --- 路由注册服务 ---
ROUTER_PORT=8090
CADDY_ADMIN_URL=http://caddy:2019

# --- Nexus ---
NEXUS_PORT=8082

# --- 备份 ---
BACKUP_DIR=./out/backups
BACKUP_RETENTION_DAYS=7
