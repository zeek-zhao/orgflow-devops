# orgflow-devops 环境变量（复制为 .env 后填写，.env 不入库）

# --- 网关（域名路由，ADR-13）---
# 域名后缀：所有站点都是 https://<subdomain>.<GATEWAY_DOMAIN>
# 认证站点的子域不在这里配，由 config/routes.yaml 里 name: auth 那条路由决定
GATEWAY_DOMAIN=org-devops.com
# 宿主端口映射（宿主 80/443 被占用时改这里，容器内始终是 80/443）
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# --- Jenkins ---
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
# Jenkins 对外通告地址（浏览器入口 / JCasC / oauth2 回跳用）
JENKINS_URL=https://jenkins.org-devops.com/
# JJB 推 Job 的连接地址：jjb 容器在 compose 网络内直连，不经网关与 oauth2（#30）
JJB_JENKINS_URL=http://jenkins:8080/
GITHUB_USER=zeek-zhao
# 必填：可读取此 private 仓库的 GitHub PAT，仅在本地 .env 填写
GITHUB_TOKEN=
# 注意：jenkins-agent 的 SSH 密钥不在 .env 里。
# 密钥对由 scripts/gen-agent-key.sh 生成到 secrets/（已 gitignore），
# deploy.sh 会自动调用；私钥挂给 Jenkins 当凭据，公钥挂给 agent 当 authorized_keys。

# --- 权限管理服务（LDAP + Admin + Dex + OAuth2 Proxy）---
LDAP_ORGANISATION=OrgFlow
LDAP_DOMAIN=devops.com
LDAP_ADMIN_PASSWORD=change-me
OAUTH2_CLIENT_ID=jenkins
OAUTH2_CLIENT_SECRET=change-me
# 仅占位；部署前替换成随机的 32 字符密钥
OAUTH2_COOKIE_SECRET=0123456789abcdef0123456789abcdef

# --- 路由注册服务 ---
CADDY_ADMIN_URL=http://caddy:2019

# --- 备份 ---
BACKUP_DIR=./out/backups
BACKUP_RETENTION_DAYS=7
