# orgflow-devops 环境变量（复制为 .env 后填写，.env 不入库）

# --- 网关（域名路由，ADR-13）---
# 域名后缀：所有站点都是 https://<subdomain>.<GATEWAY_DOMAIN>
# 认证站点的子域不在这里配，由 config/routes.yaml 里 name: auth 那条路由决定
GATEWAY_DOMAIN=org-devops.com
# 宿主端口映射（宿主 80/443 被占用时改这里，容器内始终是 80/443）
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# --- Jenkins ---
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
# Jenkins 对外通告地址（浏览器入口 / JCasC / oauth2 回跳用）
JENKINS_URL=https://jenkins.org-devops.com/
# JJB 推 Job 的连接地址：jjb 容器在 compose 网络内直连，不经网关与 oauth2（#30）
JJB_JENKINS_URL=http://jenkins:8080/
GITHUB_USER=zeek-zhao
# 必填：可读取此 private 仓库的 GitHub PAT，仅在本地 .env 填写
GITHUB_TOKEN=
# 注意：jenkins-agent 的 SSH 密钥不在 .env 里。
# 密钥对由 scripts/gen-agent-key.sh 生成到 secrets/（已 gitignore），
# deploy.sh 会自动调用；私钥挂给 Jenkins 当凭据，公钥挂给 agent 当 authorized_keys。

# --- 权限管理服务（LDAP + Admin + Dex + OAuth2 Proxy）---
LDAP_ORGANISATION=OrgFlow
LDAP_DOMAIN=devops.com
LDAP_ADMIN_PASSWORD=change-me
# 目录里 10 个初始账号共用的口令。真值只在这里，仓库 LDIF 只存它的 {SSHA} 哈希。
# deploy.sh 首次建 .env 时会随机生成；改这里之后要跑 `make ldap-passwords` 重算哈希，
# 否则 .env 里的值和目录里的哈希对不上，账号登不进去。
ORGFLOW_INITIAL_PASSWORD=change-me-12chars-min
OAUTH2_CLIENT_ID=jenkins
OAUTH2_CLIENT_SECRET=change-me
# 占位；deploy.sh 会替换成随机的 32 字符密钥。oauth2-proxy 要求 16/24/32 字节。
OAUTH2_COOKIE_SECRET=change-me-cookie-secret-32bytes-

# --- Nexus（#46：不再由 compose 拉起，改由 Jenkins job `nexus-deploy` 部署）---
# 首次启动 Nexus 会生成 /nexus-data/admin.password 里的随机密码，
# nexus-deploy 用它登录后改成这里的密码，再把初始密码文件删掉。
# 留空 = 跳过改密（Nexus 仍用初始密码，界面会强制改），不推荐。
NEXUS_ADMIN_ID=admin
NEXUS_ADMIN_PASSWORD=change-me

# --- #117 制品仓库（只登记常量位置，不新增凭据键）---
# docker / pypi 各三件套的仓库名与 connector 端口是**固定常量**，不是环境变量：
#   仓库定义  scripts/nexus-setup-repos.py（8082=docker-hosted / 8083=docker-group）
#   对外入口  config/routes.yaml（docker / pypi 两条子域）
#   验收口径  docs/services/nexus.md §「仓库三件套」
# 需要改时同时改这三处，不要只改 .env —— 这里没有对应的键。

# --- 路由注册服务 ---
CADDY_ADMIN_URL=http://caddy:2019

# --- 备份 ---
BACKUP_DIR=./out/backups
BACKUP_RETENTION_DAYS=7
# Nexus 备份/恢复按容器名走 docker（#46 之后它已不在 compose 里）；
# 改名时才需要覆盖，默认 of-nexus。
# NEXUS_CONTAINER=of-nexus

# --- GHCR（只有「推」需要凭据；13 个包全 public，拉取不需要登录）---
# 键名在此登记，值只在本地 .env 或环境变量里，绝不写进仓库。
# 令牌需 write:packages；CI 用工作流内置 GITHUB_TOKEN，不需要这两个键。
GHCR_USER=
GHCR_TOKEN=

